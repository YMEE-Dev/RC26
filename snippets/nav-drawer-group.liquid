{%- doc -%}
  Renders one link group of a mobile drawer panel: the group heading followed by its
  links. When `collapsible` is true the group renders as a native <details> dropdown —
  used for long lists (ALL COLLECTIONS) that would otherwise dominate the drawer.

  Styles live in assets/nav-menu.css (.rc-m-group*).

  @param {object} group - A link list item; its child links become the rows
  @param {boolean} [featured] - Sets the heading in the display face (Portrait LS)
  @param {boolean} [collapsible] - Renders the group as a collapsed dropdown

  @example
  {% render 'nav-drawer-group', group: group, featured: true %}
  {% render 'nav-drawer-group', group: group, collapsible: true %}
{%- enddoc -%}

{%- liquid
  assign head_class = 'rc-label rc-m-group__head'
  if featured
    assign head_class = head_class | append: ' rc-m-group__head--display'
  endif
-%}

{%- capture rows -%}
  {%- for l in group.links -%}
    <a class="rc-m-grow" href="{{ l.url }}"
      ><span class="rc-m-grow__label">{{ l.title | strip_html | downcase | escape }}</span>
      {%- render 'icon-nav-arrow', size: 'sm' -%}
    </a>
  {%- else -%}
    {%- comment -%} heading with no children — render it as a direct link {%- endcomment -%}
    <a class="rc-m-grow" href="{{ group.url }}"
      ><span class="rc-m-grow__label">{{ group.title | strip_html | downcase | escape }}</span>
      {%- render 'icon-nav-arrow', size: 'sm' -%}
    </a>
  {%- endfor -%}
{%- endcapture -%}

{%- if collapsible and group.title != blank -%}
  {%- comment -%}
    The rows sit in a wrapper, not directly in <details>: .rc-m-grow sets
    `display: flex`, which overrides the UA rule that hides a closed details' children,
    so an unwrapped list stays visible when collapsed.
  {%- endcomment -%}
  <details class="rc-m-group rc-m-group--drop">
    <summary class="{{ head_class }}">
      <span>{{ group.title | strip_html | escape }}</span>
      {%- render 'icon-nav-arrow-down' -%}
    </summary>
    <div class="rc-m-group__panel">{{ rows }}</div>
  </details>
{%- else -%}
  <div class="rc-m-group">
    {%- if group.title != blank -%}
      <div class="{{ head_class }}">{{ group.title | strip_html | escape }}</div>
    {%- endif -%}
    {{ rows }}
  </div>
{%- endif -%}
