{% comment %}
  Header init animation. Self-contained: includes its own CSS and JS.
  Renders the bars + logo entrance animation (same offsets as scroll-up reveal).

  Usage:
    {% render 'header-init-animation' %}

  Renders inline <style> and <script> — desktop and mobile. Idempotent: safe to
  render multiple times. Dispatches `theme:plp:header-ready` event when the animation
  triggers (other scripts can chain on it).
{% endcomment %}

<style>
    /* PLP entrance cascade. Every element reveals at a fixed offset from one anchor
       (`plp-header-ready` on <body>) rather than chaining on the previous section's
       events. Read by nav-menu.css, subcollections.liquid and collection.liquid.
       Keep --plp-cascade-products >= the tile stagger tail, or products overtake
       the subcategories on collections with many tiles. */
    :root {
      /* Shared by EVERY participant. Equal durations are what make the order
         predictable: same fade length means whichever starts first becomes visible
         first. Mixed durations decouple start order from visible order. */
      --plp-cascade-duration: 600ms;
      --plp-cascade-title: 150ms;
      --plp-cascade-desc: 300ms;
      --plp-cascade-subcat: 600ms;
      /* 160ms matches the per-tile rhythm already shipping on the live theme (measured
         144-182ms). Keep --plp-cascade-products above the last tile's START — 600 + 5 x
         step at the 6-tile maximum = 1400ms — so products never overtake the tiles. */
      --plp-cascade-subcat-step: 160ms;
      --plp-cascade-products: 1550ms;
      /* Templates without a subcollections section have no tile stagger to clear,
         so they use a shorter offset rather than waiting out 900ms for nothing. */
      --plp-cascade-products-solo: 400ms;
    }

    /* Slow-motion review mode (?plp-slow=N) needs no overrides here: every delay and
       duration now reads from the cascade tokens, and the JS scales those directly. */

    @keyframes plp-header-from-top { from { transform: translateY(-200px); opacity: 0; } to { transform: none; opacity: 1; } }
    @keyframes plp-header-fade-near { from { transform: translateY(-20px); opacity: 0; } to { transform: none; opacity: 1; } }
    @keyframes plp-header-from-left { from { transform: translateX(-200px); opacity: 0; } to { transform: none; opacity: 1; } }
    @keyframes plp-header-from-right { from { transform: translateX(200px); opacity: 0; } to { transform: none; opacity: 1; } }

    body.plp-header-loading .header__desktop,
    body.plp-header-loading .header__mobile {
      opacity: 0 !important;
    }

    /* Logo + breadcrumb — shared by desktop and mobile.
       The mobile selectors are additionally gated behind :not(.plp-header-anim-done)
       so the entrance plays only once per load. On a collection PLP the mobile header
       is hidden with display:none while the nav is stuck and re-shown on scroll back to
       the top — and re-showing a display:none element restarts its CSS animation, which
       made the header re-drop-in on every scroll-to-top. The one-shot flag (added ~1.8s
       after the entrance, reset on BFCache restore) stops that replay. Desktop hides via
       z-index, not display, so it never replays and is left ungated. */
    body.plp-header-ready .header__desktop__bar__l .header__logo,
    body.plp-header-ready:not(.plp-header-anim-done) .header__mobile .header__logo {
      animation: plp-header-from-top 550ms 200ms cubic-bezier(0.05, 0, 0, 1) backwards;
    }
    body.plp-header-ready .header__desktop__bar__l .header__logo__meta,
    body.plp-header-ready:not(.plp-header-anim-done) .header__mobile .header__logo__meta {
      animation: plp-header-fade-near 600ms 400ms cubic-bezier(0.05, 0, 0, 1) backwards;
    }

    /* Desktop-only: nav bars slide in from sides */
    @media (min-width: 960px) {
      body.plp-header-ready .header__desktop__bar__c {
        animation: plp-header-from-left 700ms 600ms cubic-bezier(0.05, 0, 0, 1) backwards;
      }
      body.plp-header-ready .header__desktop__bar__r {
        animation: plp-header-from-right 700ms 600ms cubic-bezier(0.05, 0, 0, 1) backwards;
      }
    }

    /* Mobile-only: left/right bars slide in from sides.
       Gated behind :not(.plp-header-anim-done) for the same reason as the logo —
       visibility: hidden → visible on the header re-shows it without display:none
       restart risk, but guard anyway so any future display toggle doesn't replay.
       While the animation is active the right bar sits at translateX(200px) — past
       the viewport edge. overflow-x:clip on html doesn't reliably clip position:fixed
       children on iOS Safari, so we clip at .section-padding (inside the fixed header)
       during the animation window. Removed once plp-header-anim-done is set (~1.8s). */
    @media (max-width: 959px) {
      body.plp-header-ready:not(.plp-header-anim-done) .theme__header .section-padding {
        overflow-x: hidden;
      }
      body.plp-header-ready:not(.plp-header-anim-done) .header__mobile .header__mobile__left {
        animation: plp-header-from-left 550ms 300ms cubic-bezier(0.05, 0, 0, 1) backwards;
      }
      body.plp-header-ready:not(.plp-header-anim-done) .header__mobile .header__mobile__right {
        animation: plp-header-from-right 550ms 300ms cubic-bezier(0.05, 0, 0, 1) backwards;
      }
    }
  </style>

  <script>
    (function () {
      if (window.__plpHeaderAnimInit) return;
      window.__plpHeaderAnimInit = true;

      if (document.body.dataset.rcAnimations === 'false') return;

      /* Slow-motion review mode: ?plp-slow=6 stretches the cascade 6x so the order
         can be eyeballed (bare ?plp-slow = 5x, capped at 20x). Scales the offsets
         only — the order is untouched. Inert without the parameter. */
      var slow = 1;
      try {
        var params = new URLSearchParams(window.location.search);
        if (params.has('plp-slow')) {
          var requested = Number.parseFloat(params.get('plp-slow'));
          slow = Number.isFinite(requested) && requested > 0 ? Math.min(requested, 20) : 5;
        }
      } catch (e) {
        /* URLSearchParams unavailable — stay at 1x */
      }

      if (slow > 1) {
        var rootEl = document.documentElement;
        [
          '--plp-cascade-title',
          '--plp-cascade-desc',
          '--plp-cascade-subcat',
          '--plp-cascade-subcat-step',
          '--plp-cascade-products',
          '--plp-cascade-products-solo',
          '--plp-cascade-duration',
        ].forEach(function (name) {
          var base = Number.parseFloat(getComputedStyle(rootEl).getPropertyValue(name));
          if (Number.isFinite(base)) rootEl.style.setProperty(name, base * slow + 'ms');
        });
        rootEl.style.setProperty('--plp-slow', String(slow));
        document.body.classList.add('plp-slow-motion');
      }
      /* Sections read this to scale their own safety timeouts. Unscaled, a 2500ms
         fallback fires long before the real schedule at high factors and releases
         products first — which is exactly how the order looked scrambled at 25x. */
      window.__plpSlow = slow;

      var doneTimer;

      var markDone = function () {
        clearTimeout(doneTimer);
        document.body.classList.add('plp-header-anim-done');
      };

      document.body.classList.add('plp-header-loading');
      var trigger = function () {
        if (document.body.classList.contains('plp-header-ready')) return;
        /* Double rAF — guarantees at least one paint with `plp-header-loading` state
           before the swap, otherwise on fully-cached reloads the trigger fires before
           first paint and the animation appears to skip. */
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            document.body.classList.add('plp-header-ready');
            document.body.classList.remove('plp-header-loading');
            /* The cascade anchor in absolute page time. Downstream sections schedule
               against this, not against whenever their own script runs — collection.liquid
               initialises at DOMContentLoaded, well after the header is up. */
            window.__plpCascadeT0 = performance.now();
            document.dispatchEvent(new CustomEvent('theme:plp:header-ready'));
            clearTimeout(doneTimer);
            /* Must exceed the 1100ms header entrance (nav-menu.css: 500ms + 600ms delay):
               `:not(.plp-header-anim-done)` stops matching the moment this lands, so a
               shorter value cuts the animation short and snaps it to its base state.
               Scaled by `slow` for the same reason. */
            doneTimer = setTimeout(markDone, 1200 * slow);
          });
        });
      };

      /* BFCache: if the page is restored from bfcache, classes and __plpHeaderAnimInit
         persist. Re-trigger so the animation plays again — clearing the done flag so
         the entrance is allowed to replay on this fresh-feeling restore. */
      window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        document.body.classList.remove('plp-header-ready');
        document.body.classList.remove('plp-header-anim-done');
        document.body.classList.add('plp-header-loading');
        trigger();
      });
      /* Must be the visible header. The legacy `.header__desktop`/`.header__mobile`
         markup is display:none since the mega-menu refactor (sections/header.liquid),
         so gating on its images gated the cascade on artwork nobody sees. */
      var headerImgs = Array.prototype.slice.call(
        document.querySelectorAll('.rc-d-logo img, .rc-mobile-bar__logo')
      );

      /* Fonts are raced, not awaited: `document.fonts.ready` is page-wide, so one slow
         face would hold the header and everything staggered behind it. */
      var FONT_CAP_MS = 500;
      var fontsReady = (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve();
      var fontsRaced = Promise.race([
        fontsReady,
        new Promise(function (resolve) { setTimeout(resolve, FONT_CAP_MS); }),
      ]);

      Promise.all([fontsRaced].concat(headerImgs.map(function (img) {
        return img.decode ? img.decode().catch(function () {}) : Promise.resolve();
      }))).then(trigger);
      setTimeout(trigger, 2000);
    })();
  </script>
