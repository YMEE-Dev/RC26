{% doc %}
  Renders free shipping information in a drawer.
  This snippet uses metaobjects for content management.
{% enddoc %}

<div class="drawer-free-shipping drawer__content-wrapper">
  {%- comment -%}
    Get free shipping content from dedicated metafields
  {%- endcomment -%}
  {%- assign free_shipping_content = nil -%}
  
  {%- if product and product.metafields.info.free_shipping_info != blank -%}
    {%- assign free_shipping_content = product.metafields.info.free_shipping_info.value -%}
  {%- elsif collection and collection.metafields.info.free_shipping_info != blank -%}
    {%- assign free_shipping_content = collection.metafields.info.free_shipping_info.value -%}
  {%- elsif shop.metafields.info.free_shipping_info != blank -%}
    {%- assign free_shipping_content = shop.metafields.info.free_shipping_info.value -%}
  {%- endif -%}
  
  {%- comment -%}
    Display metaobject content if available
  {%- endcomment -%}
  {%- if free_shipping_content != blank -%}
    <div class="free-shipping__content drawer-content__main">
      <div class="free-shipping__text-content">
        {%- if free_shipping_content.title != blank -%}
          <h2 class="free-shipping__title drawer-content__title">{{ free_shipping_content.title }}</h2>
        {%- endif -%}
        
        {%- if free_shipping_content.description != blank -%}
          <div class="free-shipping__description drawer-content__description">
            {{ free_shipping_content.description | metafield_tag }}
          </div>
        {%- endif -%}
      </div>
      
      {%- if free_shipping_content.image != blank -%}
        <div class="free-shipping__image drawer-content__image">
          {%- comment -%}
            data-src, not src — side-drawer.js swaps it in on the drawer's first open.
            This drawer is closed on load (translated off-screen), and `loading="lazy"`
            was NOT enough on its own: Chrome's lazy-load margin is generous enough that
            artwork just past the viewport edge is fetched anyway (verified — the image
            still downloaded with lazy set). Deferring the src is what actually stops it.
          {%- endcomment -%}
          {%- capture drawer_img -%}
            {{ free_shipping_content.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {%- endcapture -%}
          {{ drawer_img | replace: ' src="', ' data-src="' | replace: ' srcset="', ' data-srcset="' }}
        </div>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="free-shipping__default">
      <h2>Free Shipping</h2>
      <p>Free shipping information will appear here once configured.</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.drawer-free-shipping .drawer-content__image {
  margin-bottom: 0px;
  margin-top: auto;
}
{% endstylesheet %}
