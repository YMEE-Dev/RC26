{%- comment -%}
  nav-drawer-mobile — Roberto Coin mobile + tablet drill-down drawer.
  Root rows come from the `rc_menu` link list (top level). Any top item that has a
  matching `rc_panel` section block becomes a drill row into a menu-driven node.
  Node link groups come from the block's `panel_menu` (level-1 = heading, level-2 = links).
  Spotlight imagery comes from the theme editor: the root spotlight from the header
  section settings (m_spot_*), each node's from its block (mobile_image, falling back
  to the desktop image_1, plus eyebrow_1/heading_1/link_1). No image set means no
  spotlight — the rows start at the top of the drawer. Utility rows stay hardcoded.
  Interaction lives in the javascript tag of snippets/nav-header.liquid.

  @param {string} [rc_menu] - Handle of the main (left) link list
  @param {block[]} [blocks] - The section blocks (defaults to section.blocks)
{%- endcomment -%}

{%- liquid
  assign logo = 'nav-rc-logo-light.svg' | asset_url

  assign root_image = section.settings.m_spot_image
  assign root_eyebrow = section.settings.m_spot_eyebrow
  assign root_title = section.settings.m_spot_title
  assign root_link = section.settings.m_spot_link

  assign rc_menu = rc_menu | default: section.settings.rc_menu_linklist | default: 'main-menu'
  assign nav_blocks = blocks | default: section.blocks
-%}

<div class="rc-drawer" data-rc-drawer aria-hidden="true">
  <div class="rc-drawer__scrim"></div>

  {%- comment -%} shared header {%- endcomment -%}
  <div class="rc-drawer__header" data-rc-drawer-header>
    <div class="rc-drawer__hslot">
      <button type="button" data-rc-drawer-close aria-label="Close menu">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none">
          <path d="M6 6l12 12M18 6L6 18" stroke="#fff" stroke-width="1.2"></path>
        </svg>
      </button>
    </div>
    <img class="rc-drawer__logo" src="{{ logo }}" alt="{{ shop.name }}" width="120" height="27">
    <div class="rc-drawer__hslot rc-drawer__hslot--end">
      <a class="rc-m-bag" href="{{ routes.cart_url }}" data-cart-toggle aria-label="{{ 'cart.general.title' | t | default: 'Cart' }}">
        {%- render 'icon-cart' -%}
        <cart-count class="rc-m-bag__count" data-cart-count="{{ cart.item_count }}">{{ cart.item_count }}</cart-count>
      </a>
    </div>
  </div>

  <div class="rc-drawer__scroll" data-rc-scroll>
    {%- comment -%} ===== ROOT (menu-driven primary + hardcoded utility) ===== {%- endcomment -%}
    <div class="rc-panel" data-node="root" data-active="1">
      {%- render 'nav-drawer-spot',
        image: root_image,
        eyebrow: root_eyebrow,
        title: root_title,
        url: root_link
      -%}
      <div class="rc-m-body">
        <button type="button" class="rc-m-search" data-rc-search>
          {%- render 'icon-search' -%}
          <span>Search</span>
        </button>
        <nav class="rc-m-nav" aria-label="Primary">
          {%- for link in linklists[rc_menu].links -%}
            {%- liquid
              assign pos = forloop.index | append: ''
              assign panel_key = ''
              for block in nav_blocks
                if block.type == 'rc_panel' and block.settings.position == pos
                  assign panel_key = 'rcp-' | append: pos
                  break
                endif
              endfor
            -%}
            {%- if panel_key != '' -%}
              <button type="button" class="rc-m-row" data-rc-drill="{{ panel_key }}">
                <span class="rc-m-row__label">{{ link.title | strip_html | downcase | escape }}</span>
                {%- render 'icon-nav-chevron' %}
              </button>
            {%- else -%}
              <a class="rc-m-row" href="{{ link.url }}"
                ><span class="rc-m-row__label">{{ link.title | strip_html | downcase | escape }}</span>
                {%- render 'icon-nav-chevron' -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
        <nav class="rc-m-util" aria-label="Utility">
          <a class="rc-m-util__item" href="{% render 'nav-url', key: 'find-a-boutique' %}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" stroke="rgba(255,255,255,0.88)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>Find a Boutique</span></a
          >
          <a class="rc-m-util__item" href="{% render 'nav-url', key: 'concierge' %}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M4 5.5h16v10H8.5L4.5 19.5V5.5z M8 9.5h8 M8 12.5h5" stroke="rgba(255,255,255,0.88)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>Concierge</span></a
          >
          <a class="rc-m-util__item" href="{% render 'nav-url', key: 'login' %}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M12 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M5 20c0-3.3 3.1-5.5 7-5.5s7 2.2 7 5.5" stroke="rgba(255,255,255,0.88)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>Log In</span></a
          >
          {% comment %}
            <a class="rc-m-util__item" href="{% render 'nav-url', key: 'keep-in-touch' %}" data-rc-newsletter>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M3 6h18v12H3z M3.5 7l8.5 6 8.5-6" stroke="rgba(255,255,255,0.88)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>Keep in Touch</span></a
            >
          {% endcomment %}
        </nav>
      </div>
    </div>

    {%- comment -%} ===== PANEL NODES (one per rc_panel block) ===== {%- endcomment -%}
    {%- for block in nav_blocks -%}
      {%- if block.type != 'rc_panel' -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign panel_key = 'rcp-' | append: block.settings.position
        assign panel_menu = block.settings.panel_menu
        assign node_img = block.settings.mobile_image
        if node_img == blank
          assign node_img = block.settings.image_1
        endif
      -%}
      <div class="rc-panel" data-node="{{ panel_key }}" {{ block.shopify_attributes }} hidden>
        {%- render 'nav-drawer-spot',
          image: node_img,
          eyebrow: block.settings.eyebrow_1,
          title: block.settings.heading_1,
          url: block.settings.link_1
        -%}
        <button type="button" class="rc-m-back rc-m-back--sticky" data-rc-back>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M15 5l-7 7 7 7" stroke="rgba(255,255,255,0.9)" stroke-width="1.2"></path>
          </svg>
          <span>Back</span>
        </button>
        <div class="rc-m-cat-body">
          <div class="rc-m-groups">
            {%- for group in linklists[panel_menu].links -%}
              {%- liquid
                assign group_head = group.title | downcase
                assign is_featured_group = false
                if group_head contains 'featured' or group_head contains 'collection'
                  assign is_featured_group = true
                endif
              -%}
              <div class="rc-m-group{% if is_featured_group %} rc-m-group--feat{% endif %}">
                {%- if group.title != blank -%}
                  <div class="rc-label rc-m-group__head">{{ group.title | strip_html | escape }}</div>
                {%- endif -%}
                {%- for l in group.links -%}
                  <a class="rc-m-grow" href="{{ l.url }}"
                    ><span class="rc-m-grow__label">{{ l.title | strip_html | downcase | escape }}</span>
                    {%- render 'icon-nav-arrow', size: 'sm' -%}
                  </a>
                {%- else -%}
                  <a class="rc-m-grow" href="{{ group.url }}"
                    ><span class="rc-m-grow__label">{{ group.title | strip_html | downcase | escape }}</span>
                    {%- render 'icon-nav-arrow', size: 'sm' -%}
                  </a>
                {%- endfor -%}
              </div>
            {%- endfor -%}

            {%- comment -%}
              The desktop panel's image tiles aren't part of panel_menu, so surface their
              links here as text rows. Tile 1 is skipped when the spotlight above already
              carries it (the spotlight uses tile 1's image and link).
            {%- endcomment -%}
            {%- liquid
              assign feat1_label = block.settings.heading_1 | default: block.settings.eyebrow_1
              assign feat2_label = block.settings.heading_2 | default: block.settings.eyebrow_2

              assign show_feat1 = false
              if node_img == blank and block.settings.link_1 != blank and feat1_label != blank
                assign show_feat1 = true
              endif

              assign show_feat2 = false
              if block.settings.panel_images == 'two' and block.settings.link_2 != blank and feat2_label != blank
                assign show_feat2 = true
              endif
            -%}
            {%- if show_feat1 or show_feat2 -%}
              <div class="rc-m-group rc-m-group--feat">
                <div class="rc-label rc-m-group__head">Featured</div>
                {%- if show_feat1 -%}
                  <a class="rc-m-grow" href="{{ block.settings.link_1 }}"
                    ><span class="rc-m-grow__label">{{ feat1_label | escape }}</span>
                    {%- render 'icon-nav-arrow', size: 'sm' -%}
                  </a>
                {%- endif -%}
                {%- if show_feat2 -%}
                  <a class="rc-m-grow" href="{{ block.settings.link_2 }}"
                    ><span class="rc-m-grow__label">{{ feat2_label | escape }}</span>
                    {%- render 'icon-nav-arrow', size: 'sm' -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
