<!-- /sections/section-legal-guarantee.liquid -->
{%- liquid
  assign notice_file = 'legal-guarantee-en.svg'
  assign text_heading = section.settings.heading_en
  assign text_body = section.settings.text_en
  if request.locale.iso_code == 'it'
    assign notice_file = 'legal-guarantee-it.svg'
    assign text_heading = section.settings.heading_it
    assign text_body = section.settings.text_it
  endif
  assign notice_url = notice_file | asset_url
-%}

{%- style -%}
  {%- comment -%} Overrides nav-menu.css's 75/150px page offset, which left a ~160px desktop gap under the title. The title moves with the announcement bar, so the offset does too. {%- endcomment -%}
  @media (max-width: 1023px) {
    main.main-content--page-legal-guarantee { padding-top: calc(var(--announcement-height, 0px) + 25px); }
  }
  @media (min-width: 1024px) {
    main.main-content--page-legal-guarantee { padding-top: calc(var(--announcement-height, 0px) + 4px); }
  }
  #LegalGuarantee--{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  #LegalGuarantee--{{ section.id }} .legal-guarantee__link,
  #LegalGuarantee--{{ section.id }} .legal-guarantee__text {
    display: block;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  #LegalGuarantee--{{ section.id }} .legal-guarantee__text {
    margin-top: 40px;
  }
  {%- comment -%} .rte's list margin leaves the bullets hanging outside the text column. {%- endcomment -%}
  #LegalGuarantee--{{ section.id }} .legal-guarantee__text :is(ul, ol) {
    margin-left: 1.5em;
  }
  {%- comment -%} Served untouched as <img>: no CDN resizing, and the SVG's own .st* classes and clip-path ids stay out of the page DOM. {%- endcomment -%}
  #LegalGuarantee--{{ section.id }} .legal-guarantee__image {
    display: block;
    width: 100%;
    height: auto;
  }
{%- endstyle -%}

<section id="LegalGuarantee--{{ section.id }}" class="legal-guarantee" data-section-id="{{ section.id }}">
  <h1 class="visually-hidden">{{ 'sections.legal_guarantee.title' | t }}</h1>
  <a class="legal-guarantee__link" href="{{ notice_url }}" target="_blank" rel="noopener">
    <img
      class="legal-guarantee__image"
      src="{{ notice_url }}"
      alt="{{ 'sections.legal_guarantee.alt' | t | escape }}"
      width="595"
      height="842"
      loading="eager"
      fetchpriority="high">
    <span class="visually-hidden">{{ 'sections.legal_guarantee.open_full_size' | t }}</span>
  </a>
  {%- comment -%} The SVG's words are outlines, so this is the readable/copyable version. EN/IT fields rather than Langify so the team can edit both in the theme editor; empty falls back to the Annex I wording in the locales. {%- endcomment -%}
  <div class="legal-guarantee__text rte body-large">
    {%- if text_body != blank -%}
      {%- if text_heading != blank -%}<h2>{{ text_heading | escape }}</h2>{%- endif -%}
      {{ text_body }}
    {%- else -%}
      {{ 'sections.legal_guarantee.transcript_1_html' | t }}
      {{ 'sections.legal_guarantee.transcript_2_html' | t }}
      {{ 'sections.legal_guarantee.transcript_3_html' | t }}
      {{ 'sections.legal_guarantee.transcript_4_html' | t }}
      {{ 'sections.legal_guarantee.transcript_5_html' | t }}
      {{ 'sections.legal_guarantee.transcript_6_html' | t }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Legal guarantee notice",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows assets/legal-guarantee-it.svg on the Italian storefront and assets/legal-guarantee-en.svg everywhere else."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Text version (below the notice)"
    },
    {
      "type": "paragraph",
      "content": "Leave a text field empty to show the official EU wording."
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "English heading"
    },
    {
      "type": "richtext",
      "id": "text_en",
      "label": "English text"
    },
    {
      "type": "text",
      "id": "heading_it",
      "label": "Italian heading"
    },
    {
      "type": "richtext",
      "id": "text_it",
      "label": "Italian text"
    }
  ]
}
{% endschema %}
